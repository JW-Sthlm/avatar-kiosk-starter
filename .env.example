# Copy to .env for local development. Never commit .env.

# Azure Speech / Avatar
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral
AZURE_SPEECH_VOICE=en-US-JennyNeural
AZURE_AVATAR_CHARACTER=lisa
AZURE_AVATAR_STYLE=casual-sitting

# Track B - Azure Voice Live Avatar.
# Keep all values server-side. Browser code only receives a local session ID and ephemeral WebRTC details.
AZURE_VOICE_LIVE_ENDPOINT=https://<resource>.services.ai.azure.com
AZURE_VOICE_LIVE_API_KEY=
AZURE_VOICE_LIVE_MODEL=gpt-realtime
AZURE_VOICE_LIVE_API_VERSION=2025-10-01
AZURE_VOICE_LIVE_VOICE=en-US-Ava:DragonHDLatestNeural
AZURE_VOICE_LIVE_AVATAR_CHARACTER=lisa
AZURE_VOICE_LIVE_AVATAR_STYLE=casual-sitting
AZURE_VOICE_LIVE_REGION=westeurope

# AZURE_VOICELIVE_* aliases are also accepted for endpoint, key, model, version, voice, avatar, and region.

# Optional assistant endpoint. Leave blank to use mock mode.
ASSISTANT_API_URL=
ASSISTANT_API_KEY=

# Brand file for the kiosk. See branding/README.md.
BRAND_CONFIG_FILE=branding/helios.json

# Optional lightweight gate for sharing the prototype URL.
# Leave blank for local development; set in App Service before sharing externally.
PROTOTYPE_ACCESS_PASSWORD=

# Local server
PORT=3000
